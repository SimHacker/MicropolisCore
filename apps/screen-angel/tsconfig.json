{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"types": ["node", "svelte"],
		"baseUrl": ".",
		"paths": {
			"@common/*": ["src/common/*"],
			"@screen-angel/host-api": ["src/main/modules/module.ts"]
		}
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.svelte",
		"modules/**/*.ts",
		"electron.vite.config.ts"
	]
}
